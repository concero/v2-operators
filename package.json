{
    "name": "concero-v2-operators",
    "module": "index.ts",
    "type": "module",
    "version": "1.0.0",
    "engines": {
        "node": ">=22.0.0"
    },
    "packageManager": "node",
    "scripts": {
        "build": "esbuild src/main.ts --bundle --platform=node --target=node22 --outdir=dist --format=esm --packages=external",
        "lint": "eslint --config .eslint.config.mjs",
        "format": "prettier --config .prettierrc.json --write \"**/*.{ts,json}\"",
        "start": "node ./dist/main.js",
        "prepare": "husky",
        "test": "jest",
        "prisma:reset": "prisma migrate reset",
        "prisma:studio": "prisma studio --schema=prisma/schema.prisma",
        "prisma:migrate:dev": "prisma migrate dev",
        "prisma:migrate:deploy": "prisma migrate deploy",
        "prisma:generate": "prisma generate",
        "postinstall": "npm run prisma:generate"
    },
    "dependencies": {
        "@concero/operator-utils": "https://github.com/concero/operator-utils.git#feature/new-balance-manager",
        "@openzeppelin/merkle-tree": "^1.0.8",
        "@prisma/client": "6.16.2",
        "@slack/web-api": "7.9.1",
        "axios": "^1.13.2",
        "dotenv": "16.4.7",
        "fastify": "^5.6.2",
        "json-stable-stringify": "^1.3.0",
        "ts-jest": "29.3.2",
        "viem": "2.37.6",
        "winston": "3.17.0",
        "winston-daily-rotate-file": "5.0.0"
    },
    "devDependencies": {
        "@ianvs/prettier-plugin-sort-imports": "4.7.0",
        "@types/jest": "^30.0.0",
        "@typescript-eslint/eslint-plugin": "8.22.0",
        "@typescript-eslint/parser": "8.22.0",
        "esbuild": "0.25.6",
        "eslint-plugin-prettier": "5.2.3",
        "husky": "9.1.7",
        "jest": "29.7.0",
        "prettier": "3.4.2",
        "prettier-plugin-jsdoc": "1.3.2",
        "prettier-plugin-organize-imports": "4.1.0",
        "prisma": "6.16.2",
        "swc": "1.0.11",
        "typescript": "^5.9.2"
    }
}
