{
    "name": "concero-v2-operators",
    "module": "index.ts",
    "type": "module",
    "version": "1.0.0",
    "engines": {
        "node": ">=22.0.0"
    },
    "packageManager": "bun",
    "scripts": {
        "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --outdir=dist --format=esm --packages=external",
        "build:new": "esbuild src/main.ts --bundle --platform=node --target=node22 --outdir=dist --format=esm --packages=external",
        "build:cjs": "esbuild src/index.ts --bundle --platform=node --target=node22 --outdir=dist --format=cjs --out-extension=.js=.cjs --packages=external",
        "lint": "eslint --config .eslint.config.mjs",
        "format": "prettier --config .prettierrc.json --write \"**/*.{ts,json}\"",
        "start": "bun run start:dev",
        "start:node": "NODE_ENV=development node --env-file=.env ./dist/index.js",
        "start:new:dev": "bun ./src/main.ts",
        "start:new:prod": "bun ./dist/main.js",
        "start:prod": "NODE_ENV=production bun ./dist/index.js",
        "start:relayerA": "bun ./src/index.ts",
        "start:db": "docker compose -f ./docker/docker-compose.yml --env-file ./.env.database up -d --build",
        "check-updates": "bun npm-check-updates",
        "prepare": "husky",
        "test": "jest",
        "prisma:reset": "prisma migrate reset",
        "prisma:studio": "prisma studio --schema=prisma/schema.prisma",
        "prisma:migrate:dev": "prisma migrate dev",
        "prisma:migrate:deploy": "prisma migrate deploy && prisma generate",
        "prisma:generate": "prisma generate",
        "postinstall": "bun run prisma:generate"
    },
    "devDependencies": {
        "@ianvs/prettier-plugin-sort-imports": "4.7.0",
        "@typescript-eslint/eslint-plugin": "8.22.0",
        "@typescript-eslint/parser": "8.22.0",
        "esbuild": "0.25.6",
        "eslint-plugin-prettier": "5.2.3",
        "husky": "9.1.7",
        "prettier": "3.4.2",
        "prettier-plugin-jsdoc": "1.3.2",
        "prettier-plugin-organize-imports": "4.1.0",
        "swc": "1.0.11",
        "typescript": "5.9.2",
        "prisma": "6.16.2",
        "jest": "29.7.0"
    },
    "peerDependencies": {
        "typescript": "5.0.0"
    },
    "dependencies": {
        "@concero/operator-utils": "https://github.com/concero/operator-utils.git#development",
        "@prisma/client": "6.16.2",
        "@slack/web-api": "7.9.1",
        "@types/jest": "29.5.14",
        "async-mutex": "0.5.0",
        "axios": "^1.13.2",
        "dotenv": "16.4.7",
        "fastify": "^5.6.2",
        "json-stable-stringify": "^1.3.0",
        "ts-jest": "29.3.2",
        "uuid": "11.1.0",
        "viem": "2.37.6",
        "winston": "3.17.0",
        "winston-daily-rotate-file": "5.0.0"
    }
}
