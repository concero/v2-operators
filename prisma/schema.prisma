// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model LogsListenerBlockCheckpoints {
  id              Int      @id @default(autoincrement())
  chainSelector   Int
  contractAddress String
  blockNumber     BigInt
  timestamp       DateTime @default(now())

  @@unique([chainSelector, contractAddress])
  @@index([chainSelector, contractAddress])
  @@map("logsListener_blockCheckpoints")
}

model Job {
  id              Int      @id @default(autoincrement())
  messageId       String   @unique
  srcChainSelector  Int
  srcBlockNumberDelta String
  dstChainSelector  Int
  dstBlockNumberDelta String
  status          String
  payload         String  @default("{}")
  attempts        Int      @default(0)
  nextRetryAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([nextRetryAt])
  @@map("job")
}
