// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model LogsListenerBlockCheckpoints {
  id              Int      @id @default(autoincrement())
  chainSelector   Int
  contractAddress String
  blockNumber     BigInt
  timestamp       DateTime @default(now())

  @@unique([chainSelector, contractAddress])
  @@index([chainSelector, contractAddress])
  @@map("logsListener_blockCheckpoints")
}

model Job {
  id            Int     @id @default(autoincrement())
  messageId     String  @unique
  payload       String  @default("{}")
  validatorType String
  status        String
  errorCode     String?

  // VERIFICATION
  verificationAttempts  Int       @default(0)
  lastVerificationAt    DateTime?
  verificationPlannedTo DateTime?

  // SUBMIT 
  submitAttempts  Int       @default(0)
  lastSubmitAt    DateTime?
  submitPlannedTo DateTime?

  callbacksCount Int @default(0)

  // src
  srcTxHash           String
  srcChainSelector    Int
  srcBlockNumber      String
  srcBlockNumberDelta String

  // dst
  dstTxHash        String?
  dstChainSelector Int
  dstBlockNumber   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creCallbacks CreCallback[] // @todo: remove callbacks

  @@index([dstChainSelector])
  @@index([srcChainSelector])
  @@index([messageId])
  @@map("job")
}

// @todo: remove callbacks
model CreCallback {
  id        Int    @id @default(autoincrement())
  messageId String
  payload   String

  job Job @relation(fields: [messageId], references: [messageId])

  @@index([messageId])
  @@map("cre_callback")
}

enum CounterType {
  creBufferSize // count of waiting for response from CRE side
}

model Counter {
  type  CounterType @unique
  value Int

  @@index([type])
  @@map("counter")
}
