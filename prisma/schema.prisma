// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model LogsListenerBlockCheckpoints {
  id              Int      @id @default(autoincrement())
  chainSelector   Int
  contractAddress String
  blockNumber     BigInt
  timestamp       DateTime @default(now())

  @@unique([chainSelector, contractAddress])
  @@index([chainSelector, contractAddress])
  @@map("logsListener_blockCheckpoints")
}

model Job {
  id              Int      @id @default(autoincrement())
  messageId       String   @unique
  payload         String  @default("{}")
  validatorType  String
  callbacksCount Int?
  status          String

  // src
  srcTxHash String
  srcChainSelector  Int
  srcBlockNumber String
  srcBlockNumberDelta String

  // dst
  dstTxHash String?
  dstChainSelector  Int
  dstBlockNumber String?
  dstBlockNumberDelta String

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("job")
}

model CreCallback {
  messageId       String
  payload String

  @@id([messageId])
  @@map("cre_callback")
}