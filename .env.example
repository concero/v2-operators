# --- Core Configuration ---
NODE_ENV=development
NETWORK_MODE=testnet
OPERATOR_ADDRESS=0xYourOperatorAddressHere
OPERATOR_PRIVATE_KEY=your_private_key_here

# --- URLs Configuration ---
URLS_CONCERO_RPCS=https://raw.githubusercontent.com/concero/rpcs/refs/heads/master/output
URLS_CONCERO_DEPLOYMENTS=https://raw.githubusercontent.com/concero/v2-contracts/refs/heads/master/.env.deployments.testnet
URLS_V2_NETWORKS_MAINNET=https://github.com/concero/v2-networks/raw/refs/heads/master/networks/mainnet.json
URLS_V2_NETWORKS_TESTNET=https://github.com/concero/v2-networks/raw/refs/heads/master/networks/testnet.json
URLS_RPC_SERVICE_GIT_BRANCH=master
URLS_DEPLOYMENTS_SERVICE_GIT_BRANCH=master

# --- Logging Configuration ---
LOGGER_LOG_LEVEL_DEFAULT=debug
LOGGER_LOG_DIR=logs
LOGGER_LOG_MAX_FILES=7d
LOGGER_LOG_MAX_SIZE=20m
# Optional granular logging levels
# LOGGER_LOG_LEVELS_GRANULAR_TxMonitor=debug
# LOGGER_LOG_LEVELS_GRANULAR_TxWriter=debug
# LOGGER_LOG_LEVELS_GRANULAR_Relayer=debug
# LOGGER_LOG_LEVELS_GRANULAR_ViemTransport=debug

# --- HTTP Client Configuration ---
HTTPCLIENT_DEFAULT_TIMEOUT=5000
HTTPCLIENT_MAX_RETRIES=3
HTTPCLIENT_RETRY_DELAY=100

# --- Viem Configuration ---
VIEM_SIMULATE_TX=false
VIEM_TX_RECEIPT_CONFIRMATIONS=1
VIEM_TX_RECEIPT_RETRY_COUNT=5
VIEM_TX_RECEIPT_RETRY_DELAY=1000
VIEM_TX_RECEIPT_TIMEOUT=30000
VIEM_HTTP_TRANSPORT_TIMEOUT=5000
VIEM_HTTP_TRANSPORT_BATCH=true
VIEM_HTTP_TRANSPORT_RETRY_COUNT=5
VIEM_HTTP_TRANSPORT_RETRY_DELAY=100
VIEM_FALLBACK_TRANSPORT_RETRY_COUNT=5
VIEM_FALLBACK_TRANSPORT_RETRY_DELAY=150
VIEM_RELAYER_MESSAGE_REPORT_REQUEST_CONFIRMATIONS=3
VIEM_RELAYER_MESSAGE_REPORT_REQUEST_TIMEOUT_MS=60000

# --- TX Writer Configuration ---
TX_WRITER_DRY_RUN=false
TX_WRITER_DEFAULT_RECEIPT_TIMEOUT=60000
TX_WRITER_GAS_LIMIT_DEFAULT=2000000
TX_WRITER_GAS_LIMIT_SUBMIT_MESSAGE_REPORT_OVERHEAD=1000000

# --- Network Manager Configuration ---
NETWORK_MANAGER_DEFAULT_FINALITY_CONFIRMATIONS=12
NETWORK_MANAGER_NETWORK_UPDATE_INTERVAL_MS=3600000

# --- Block Manager Configuration ---
BLOCK_MANAGER_POLLING_INTERVAL_MS=5000
BLOCK_MANAGER_SEQUENTIAL_BATCH_SIZE=100
BLOCK_MANAGER_CATCHUP_BATCH_SIZE=500
BLOCK_MANAGER_MAX_BLOCKS_TO_PROCESS=100
BLOCK_MANAGER_USE_CHECKPOINTS=false

# --- Balance Manager Configuration ---
BALANCE_MANAGER_DEFAULT_MIN_BALANCE=1000000
BALANCE_MANAGER_POLLING_INTERVAL_MS=100000

# --- Notifications Configuration ---
NOTIFICATIONS_INTERVAL=3600000
NOTIFICATIONS_SLACK_MONITORING_SYSTEM_CHANNEL_ID=your_slack_channel_id
NOTIFICATIONS_SLACK_BOT_TOKEN=your_slack_bot_token

# --- Transaction Monitor Configuration ---
TX_MONITOR_MAX_INCLUSION_ATTEMPTS=5

# --- Localhost Development ---
LOCALHOST_FORK_CHAIN_ID=1
LOCALHOST_RPC_URL=http://127.0.0.1:8545
LOCALHOST_FORK_BLOCK_NUMBER=21290306

# --- Localhost vars ---
USDC_LOCALHOST=0xYourUSDCAddress
